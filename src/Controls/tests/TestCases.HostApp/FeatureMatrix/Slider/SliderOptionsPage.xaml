<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Maui.Controls.Sample"
             x:Class="Maui.Controls.Sample.SliderOptionsPage"
             x:DataType="local:SliderViewModel"
             Title="SliderFeature">
  <ContentPage.ToolbarItems>
    <ToolbarItem Text="Apply" Clicked="ApplyButton_Clicked" AutomationId="Apply"/>
  </ContentPage.ToolbarItems>

  <ScrollView>
  <Grid Padding="10" ColumnDefinitions="*, *" RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto" ColumnSpacing="6">
    <!-- Left Column -->
    <StackLayout Grid.Column="0" Padding="3" Spacing="3">
      <HorizontalStackLayout Spacing="3">
        <Label Text="{Binding Minimum, StringFormat='Minimum: {0}'}" FontSize="11" />
        <Entry x:Name="MinimumEntry" AutomationId="MinimumEntry" TextChanged="OnMinimumChanged" Keyboard="Numeric" HorizontalOptions="Start" WidthRequest="100" FontSize="11" />
    </HorizontalStackLayout>
      <!-- Maximum Value -->
    <HorizontalStackLayout Spacing="3">
      <Label Text="{Binding Maximum, StringFormat='Maximum: {0}'}" FontSize="11" />
      <Entry x:Name="MaximumEntry" AutomationId="MaximumEntry" TextChanged="OnMaximumChanged" Keyboard="Numeric" HorizontalOptions="Start" WidthRequest="100" FontSize="11" />
    </HorizontalStackLayout>
      <!-- Current Value -->
    <HorizontalStackLayout Spacing="3">
      <Label Text="{Binding Value, StringFormat='Value: {0}'}" FontSize="11" />
      <Entry x:Name="ValueEntry" AutomationId="ValueEntry" TextChanged="OnValueChanged" Keyboard="Numeric" HorizontalOptions="Start" WidthRequest="100" FontSize="11" />
    </HorizontalStackLayout>
      <!-- Flow Direction -->
    <Label Text="Flow Direction:" FontSize="11" />
      <StackLayout Orientation="Horizontal">
        <RadioButton x:Name="FlowDirectionLTR" AutomationId="FlowDirectionLTR" GroupName="FlowDirection" Content="LTR" IsChecked="True" FontSize="11" CheckedChanged="OnFlowDirectionChanged" />
        <RadioButton x:Name="FlowDirectionRTL" AutomationId="FlowDirectionRTL" GroupName="FlowDirection" Content="RTL" FontSize="11" CheckedChanged="OnFlowDirectionChanged" />
      </StackLayout>
      <!-- Is Enabled -->
      <Label Text="Is Enabled:" FontSize="11" />
      <StackLayout Orientation="Horizontal">
        <RadioButton x:Name="IsEnabledTrueRadio" AutomationId="IsEnabledTrueRadio" GroupName="IsEnabled" Content="True" IsChecked="True" FontSize="11" CheckedChanged="OnIsEnabledCheckedChanged" />
        <RadioButton x:Name="IsEnabledFalseRadio" AutomationId="IsEnabledFalseRadio" GroupName="IsEnabled" Content="False" FontSize="11" CheckedChanged="OnIsEnabledCheckedChanged" />
      </StackLayout>
      <!-- Is Visible -->
      <Label Text="Is Visible:" FontSize="11" />
      <StackLayout Orientation="Horizontal">
        <RadioButton x:Name="IsVisibleTrueRadio" AutomationId="IsVisibleTrueRadio" GroupName="IsVisible" Content="True" IsChecked="True" FontSize="11" CheckedChanged="OnIsVisibleCheckedChanged" />
        <RadioButton x:Name="IsVisibleFalseRadio" AutomationId="IsVisibleFalseRadio" GroupName="IsVisible" Content="False" FontSize="11" CheckedChanged="OnIsVisibleCheckedChanged" />
      </StackLayout>
      <!-- Height Request -->
      <HorizontalStackLayout Spacing="3">
        <Label Text="{Binding HeightRequest, StringFormat='HeightRequest: {0}'}" FontSize="11" />
        <Entry x:Name="HeightRequestEntry" AutomationId="HeightRequestEntry" TextChanged="OnHeightRequestChanged" Keyboard="Numeric" HorizontalOptions="Start" WidthRequest="100" FontSize="11" />
      </HorizontalStackLayout>
      <!-- Width Request -->
      <HorizontalStackLayout Spacing="3">
        <Label Text="{Binding WidthRequest, StringFormat='WidthRequest: {0}'}" FontSize="11" />
        <Entry x:Name="WidthRequestEntry" AutomationId="WidthRequestEntry" TextChanged="OnWidthRequestChanged" Keyboard="Numeric" HorizontalOptions="Start" WidthRequest="100" FontSize="11" />
      </HorizontalStackLayout>
      <!-- Opacity -->
      <HorizontalStackLayout Spacing="3">
        <Label Text="{Binding Opacity, StringFormat='Opacity: {0}'}" FontSize="11" />
        <Entry x:Name="OpacityEntry" AutomationId="OpacityEntry" TextChanged="OnOpacityChanged" Keyboard="Numeric" HorizontalOptions="Start" WidthRequest="100" FontSize="11" />
      </HorizontalStackLayout>
    </StackLayout>

    <StackLayout Grid.Column="1" Padding="3" Spacing="3">
      <!-- Minimum Track Color -->
      <Label Text="Minimum Track Color:" />
      <StackLayout Orientation="Horizontal" Spacing="3">
        <Button Text="Green" BackgroundColor="Green" TextColor="White" Clicked="MinTrackColorButton_Clicked" AutomationId="MinTrackColorGreenButton" FontSize="11"/>
        <Button Text="Yellow" BackgroundColor="Yellow" TextColor="Black" Clicked="MinTrackColorButton_Clicked" AutomationId="MinTrackColorYellowButton" FontSize="11"/>
      </StackLayout>
      <!-- Thumb Color -->
      <Label Text="Thumb Color:" FontSize="11" />
      <StackLayout Orientation="Horizontal" Spacing="3">
        <Button Text="Red" BackgroundColor="Red" TextColor="White" Clicked="ThumbColorButton_Clicked" AutomationId="ThumbColorRedButton" FontSize="11"/>
        <Button Text="Green" BackgroundColor="Green" TextColor="White" Clicked="ThumbColorButton_Clicked" AutomationId="ThumbColorGreenButton" FontSize="11"/>
      </StackLayout>
      <!-- Maximum Track Color -->
      <Label Text="Maximum Track Color:" />
      <StackLayout Orientation="Horizontal" Spacing="3">
        <Button Text="Red" BackgroundColor="Red" TextColor="White" Clicked="MaxTrackColorButton_Clicked" AutomationId="MaxTrackColorRedButton" FontSize="11"/>
        <Button Text="Orange" BackgroundColor="Orange" TextColor="White" Clicked="MaxTrackColorButton_Clicked" AutomationId="MaxTrackColorOrangeButton" FontSize="11"/>
      </StackLayout>
      <!-- Background Color -->
      <Label Text="Background Color:" />
      <StackLayout Orientation="Horizontal" Spacing="3">
        <Button Text="Gray" BackgroundColor="Gray" TextColor="White" Clicked="BackgroundColorButton_Clicked" AutomationId="BackgroundColorGrayButton" FontSize="11"/>
        <Button Text="Light Blue" BackgroundColor="LightBlue" TextColor="Black" Clicked="BackgroundColorButton_Clicked" AutomationId="BackgroundColorLightBlueButton" FontSize="11"/>
      </StackLayout>
      <!-- Thumb Image Source -->
      <Label Text="Thumb Image:" />
      <StackLayout Orientation="Horizontal" Spacing="3">
        <Button Text="Add Image" Clicked="ThumbImageSourceButton_Clicked" WidthRequest="100" HorizontalOptions="Start" AutomationId="ThumbImageSourceButton"/>
        <Button Text="Reset" Clicked="ThumbImageResetButton_Clicked" WidthRequest="100" HorizontalOptions="Start" AutomationId="ThumbImageResetButton"/>
      </StackLayout>
      <!-- Horizontal Options -->
      <Label Text="Horizontal Options:" FontSize="11"/>
      <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto">
        <RadioButton x:Name="HorizontalOptionsStartRadio"
                     Grid.Row="0" Grid.Column="0"
                     FontSize="11"
                     AutomationId="HorizontalOptionsStartRadio"
                     GroupName="HorizontalOptions"
                     Content="Start"
                     CheckedChanged="OnHorizontalOptionsCheckedChanged" />
        <RadioButton x:Name="HorizontalOptionsCenterRadio"
                     Grid.Row="0" Grid.Column="1"
                     FontSize="11"
                     AutomationId="HorizontalOptionsCenterRadio"
                     GroupName="HorizontalOptions"
                     Content="Center"
                     CheckedChanged="OnHorizontalOptionsCheckedChanged" />
        <RadioButton x:Name="HorizontalOptionsEndRadio"
                     Grid.Row="1" Grid.Column="0"
                     FontSize="11"
                     AutomationId="HorizontalOptionsEndRadio"
                     GroupName="HorizontalOptions"
                     Content="End"
                     CheckedChanged="OnHorizontalOptionsCheckedChanged" />
        <RadioButton x:Name="HorizontalOptionsFillRadio"
                     Grid.Row="1" Grid.Column="1"
                     FontSize="11"
                     AutomationId="HorizontalOptionsFillRadio"
                     GroupName="HorizontalOptions"
                     Content="Fill"
                     CheckedChanged="OnHorizontalOptionsCheckedChanged" />
      </Grid>
      <!-- Vertical Options -->
      <Label Text="Vertical Options:" FontSize="11"/>
      <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto">
        <RadioButton x:Name="VerticalOptionsStartRadio"
                     Grid.Row="0" Grid.Column="0"
                     FontSize="11"
                     AutomationId="VerticalOptionsStartRadio"
                     GroupName="VerticalOptions"
                     Content="Start"
                     CheckedChanged="OnVerticalOptionsCheckedChanged" />
        <RadioButton x:Name="VerticalOptionsCenterRadio"
                     Grid.Row="0" Grid.Column="1"
                     FontSize="11"
                     AutomationId="VerticalOptionsCenterRadio"
                     GroupName="VerticalOptions"
                     Content="Center"
                     CheckedChanged="OnVerticalOptionsCheckedChanged" />
        <RadioButton x:Name="VerticalOptionsEndRadio"
                     Grid.Row="1" Grid.Column="0"
                     FontSize="11"
                     AutomationId="VerticalOptionsEndRadio"
                     GroupName="VerticalOptions"
                     Content="End"
                     CheckedChanged="OnVerticalOptionsCheckedChanged" />
        <RadioButton x:Name="VerticalOptionsFillRadio"
                     Grid.Row="1" Grid.Column="1"
                     FontSize="11"
                     AutomationId="VerticalOptionsFillRadio"
                     GroupName="VerticalOptions"
                     IsChecked="True"
                     Content="Fill"
                     CheckedChanged="OnVerticalOptionsCheckedChanged" />
      </Grid>
    </StackLayout>
  </Grid>
  </ScrollView>
</ContentPage>
